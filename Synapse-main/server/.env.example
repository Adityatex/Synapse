# =============================================================================
# Synapse backend — authoritative config list (P0-14).
# Copy to `.env`:  cp .env.example .env
# Boot-time validation (server/config/env.js, zod) fails fast if required
# values are missing or placeholders. Never commit real secrets.
# =============================================================================

# --- Runtime ---
PORT=5000
NODE_ENV=development # development | test | production
LOG_LEVEL=debug # fatal,error,warn,info,debug,trace,silent
APP_RELEASE= # e.g. server@1.0.0 or git sha; used for logs + Sentry release
SENTRY_DSN= # empty = Sentry disabled (dev default)

# --- Auth (REQUIRED) ---
# min 16 chars dev/test, min 32 chars + non-placeholder in production
JWT_SECRET=replace_with_a_secure_secret_min_32_chars

# --- Database ---
# mongodb://... or mongodb+srv://...  (required in production)
MONGODB_URI=your_mongodb_connection_string
MONGO_RETRY_DELAY_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# --- CORS (at least one REQUIRED in production; comma-separated https URLs) ---
CORS_ORIGIN=https://your-vercel-app.vercel.app
CLIENT_URL=https://your-vercel-app.vercel.app
DNS_RESULT_ORDER=ipv4first

# --- Judge0 code execution ---
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key

# --- Groq AI (Neura) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# --- OTP auth ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY_MODE=auto # auto | smtp | resend | brevo | mock

# Gmail / SMTP (Nodemailer)
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM=Synapse <your_gmail_address>
# aliases honored by emailService:
# EMAIL_USER (fallback for GMAIL_USER), EMAIL_PASS (fallback for GMAIL_APP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT=60000
SMTP_GREETING_TIMEOUT=60000
SMTP_SOCKET_TIMEOUT=60000
SMTP_FALLBACK_TIMEOUT=12000
SMTP_MAX_FALLBACK_ATTEMPTS=2

# Resend (optional OTP provider)
RESEND_API_KEY=
RESEND_FROM=

# Brevo (recommended for OTP in production)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=Synapse
