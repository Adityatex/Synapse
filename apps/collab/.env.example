# @synapse/collab — copy to .env (never commit real values). Validated at boot (src/config.ts).
PORT=5001
NODE_ENV=development # development | test | production
LOG_LEVEL=debug
APP_RELEASE=
# Must match the api's JWT_SECRET: collab verifies the tokens the api signs. >= 32 chars in production.
JWT_SECRET=replace_with_the_same_secret_as_the_api
# Same database as the api (collab reads the rooms collection for membership).
MONGODB_URI=mongodb://127.0.0.1:27017/synapse
# Empty = single instance. Set it to run more than one replica.
REDIS_URL=redis://127.0.0.1:6379
# Per-IP websocket connections per minute before a 5-minute ban. Raise for campus/shared networks.
COLLAB_CONNECTIONS_PER_MIN=300
