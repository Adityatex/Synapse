{
  "name": "@synapse/collab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hocuspocus collaboration server: one Y.Doc per room (P2-03)",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo \"@synapse/collab: lint ok\""
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^4.7.1",
    "@hocuspocus/extension-throttle": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@synapse/redis": "workspace:*",
    "@synapse/room-doc": "workspace:*",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "pino": "^10.3.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5",
    "@synapse/ydoc-store": "workspace:*"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
