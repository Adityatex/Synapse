{
  "name": "@synapse/loadtest",
  "version": "1.0.0",
  "private": true,
  "description": "Load test for the collab server (P2-13): N editors in M rooms across several replicas; measures propagation latency, divergence and memory",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo \"@synapse/loadtest: lint ok\""
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.7.1",
    "@synapse/ydoc-store": "workspace:*",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
