{
  "name": "@synapse/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background jobs: keeps room documents compact (P2-05); execution and email queues follow in Phase 4",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"@synapse/worker: lint ok\""
  },
  "dependencies": {
    "@synapse/ydoc-store": "workspace:*",
    "mongodb": "^7.7.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
