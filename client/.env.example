# =============================================================================
# Synapse frontend — authoritative config list (P0-14). Copy to `.env`.
# Every VITE_* key referenced in client/src (see src/config/apiConfig.js).
# =============================================================================

# --- Local dev ---
VITE_DEV_HOST=0.0.0.0
VITE_PORT=5173
VITE_BACKEND_PORT=5000
VITE_DEV_BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_PUBLIC_APP_URL=http://YOUR_LAN_IP:5173

# --- Auth UX ---
VITE_AUTH_REQUEST_TIMEOUT_MS=25000

# --- Error tracking (P0-10; empty = Sentry disabled) ---
VITE_SENTRY_DSN=
VITE_APP_RELEASE=client@1.0.0

# --- Production (Vercel) — override in the Vercel dashboard ---
# VITE_API_URL=https://your-render-service.onrender.com/api
# VITE_SOCKET_URL=https://your-render-service.onrender.com
# VITE_PUBLIC_APP_URL=https://your-vercel-app.vercel.app
# VITE_SENTRY_DSN=https://your-client-dsn@sentry.io/project
# VITE_APP_RELEASE=client@1.0.0
