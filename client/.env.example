# =====================================================================
# Synapse frontend — authoritative environment variable list (P0-14).
# Copy to `.env` for local dev:  cp .env.example .env
# `.env` is gitignored — never commit real values.
# Vite only exposes VITE_* variables to the browser. Never put secrets here.
# =====================================================================

# --- Local development ----------------------------------------------------
# Host/port for `npm run dev`.
VITE_DEV_HOST=0.0.0.0
VITE_PORT=5173
# Backend the dev server proxies /api to (see vite.config.js).
VITE_BACKEND_PORT=5000
VITE_DEV_BACKEND_URL=http://localhost:5000
# Direct backend URLs used by the app (override for LAN testing).
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Base URL used when copying room invite links.
VITE_PUBLIC_APP_URL=http://localhost:5173

# --- Production (Vercel) — set in the Vercel dashboard --------------------
# VITE_API_URL=https://your-render-service.onrender.com/api
# VITE_SOCKET_URL=https://your-render-service.onrender.com
# VITE_PUBLIC_APP_URL=https://your-vercel-app.vercel.app

# --- Error tracking (optional) --------------------------------------------
# Leave unset to disable (safe no-op). Set VITE_SENTRY_RELEASE to the
# deployed commit in Vercel (e.g. hook it to VERCEL_GIT_COMMIT_SHA) so
# reports are tagged; defaults to 'dev'. CI tags preview builds with the SHA.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# VITE_SENTRY_RELEASE=

# --- Tuning (optional) ----------------------------------------------------
# Auth request timeout in ms.
VITE_AUTH_REQUEST_TIMEOUT_MS=25000
