{
  "name": "synapse-root",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative IDE Root (pnpm workspaces + Turborepo)",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter client dev",
    "dev:api": "docker compose up -d --build --renew-anon-volumes",
    "dev:down": "docker compose down",
    "dev:local": "turbo run dev",
    "dev:legacy": "node scripts/dev.js",
    "demo": "node scripts/demo.js up",
    "demo:eval": "node scripts/demo.js up --image synapse:eval-2",
    "demo:url": "node scripts/demo.js url",
    "demo:down": "node scripts/demo.js down",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
