{
  "name": "synapse-root",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative IDE Root (pnpm workspaces + Turborepo)",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:legacy": "node scripts/dev.js",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
