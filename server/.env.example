# =====================================================================
# Synapse backend — authoritative environment variable list (P0-14).
# Copy to `.env` for local dev:  cp .env.example .env
# `.env` is gitignored — never commit real values.
#
# Legend:  [REQUIRED in production]  — server refuses to boot without it.
#          [REQUIRED always]          — needed in every environment.
#          (optional)                 — has a safe default; set to override.
# =====================================================================

# --- Core ---------------------------------------------------------------
NODE_ENV=development
# [REQUIRED always] Random secret ≥ 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars_long
# [REQUIRED in production] MongoDB Atlas connection string. Optional locally
# (auth + persistence are disabled without it, with a warning).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# [REQUIRED in production] Comma-separated allowed web origins, e.g.
# https://your-vercel-app.vercel.app. Optional locally (CORS is permissive).
CORS_ORIGIN=http://localhost:5173
# (optional) Port the API listens on. Render injects its own PORT at runtime.
PORT=5000

# --- Code execution (Judge0 via RapidAPI) --------------------------------
# Required for /api/execute. Without these, execution returns a generic error.
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key

# --- AI chat (Groq) ------------------------------------------------------
# Required for /api/ai/chat.
GROQ_API_KEY=your_groq_api_key
# (optional)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# --- OTP email — Brevo (recommended for production) ----------------------
# Sign up at brevo.com, verify a sender, create an API key.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=Synapse
# (optional) Delivery order: auto (Brevo → Resend → SMTP) or brevo/resend/smtp.
OTP_DELIVERY_MODE=auto
# (optional)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- OTP email — Resend (alternative) ------------------------------------
RESEND_API_KEY=
RESEND_FROM=Synapse <onboarding@resend.dev>

# --- OTP email — SMTP / Gmail App Password (legacy fallback) -------------
# Kept for backwards compatibility. Prefer Brevo above: Gmail SMTP is
# rate-limited and frequently blocked on cloud hosts (see README).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Synapse <you@yourdomain.com>
# (optional, advanced SMTP tuning)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT=60000
SMTP_GREETING_TIMEOUT=60000
SMTP_SOCKET_TIMEOUT=60000
SMTP_FALLBACK_TIMEOUT=12000
SMTP_MAX_FALLBACK_ATTEMPTS=2
DNS_RESULT_ORDER=ipv4first

# --- Observability --------------------------------------------------------
# (optional) Structured-log level: debug|info|warn|error. Default info.
LOG_LEVEL=info
# (optional) Sentry error tracking. Leave unset to disable (safe no-op).
SENTRY_DSN=
# (optional) Release tag for error reports. CI sets it to the commit SHA;
# on Render RENDER_GIT_COMMIT is used automatically when this is unset.
SENTRY_RELEASE=

# --- Resilience tuning (optional, advanced) -------------------------------
MONGO_RETRY_DELAY_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
